# Copy to .env for local overrides. Never commit real secrets.

# Database
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/forensic_platform
SPRING_DATASOURCE_USERNAME=forensics
SPRING_DATASOURCE_PASSWORD=change-me
POSTGRES_PASSWORD=change-me

# Authentication
JWT_SECRET=replace-with-a-long-random-secret-of-at-least-64-characters
JWT_ACCESS_EXPIRATION=900000
JWT_REFRESH_EXPIRATION=604800000
ACCOUNT_LOCK_DURATION=900000

# Development seed data (set both to false outside development)
SEED_DEVELOPMENT_USERS=true
SEED_DEMO_CASES=true

# CORS / frontend
FRONTEND_URL=http://localhost:5173,http://localhost:3000
# Leave unset to use the same-origin /api/v1 path (Vite proxy or Nginx).
# VITE_API_BASE_URL=http://localhost:8080/api/v1

# Evidence storage and ingestion
EVIDENCE_STORAGE_DIR=./data/evidence
UPLOAD_MAX_BYTES=104857600
PROCESSING_ASYNC=true
PROCESSING_WORKERS=2

# AI service (backend side)
AI_SERVICE_URL=http://localhost:8000
AI_TIMEOUT_SECONDS=60
AI_MAX_RECORDS=150

# AI service (ai-service side). Generative analysis is OFF unless BOTH are set.
# Setting these sends selected evidence records to the model provider - only enable where policy allows.
ANTHROPIC_API_KEY=
AI_ALLOW_EXTERNAL_PROCESSING=false
AI_MODEL=claude-opus-5-5
